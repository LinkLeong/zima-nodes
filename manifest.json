{
  "manifest_version": 3,
  "name": "Zima Nodes",
  "version": "1.0.4",
  "description": "A Chrome extension to manage and access your ZimaOS system",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zima Nodes",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}